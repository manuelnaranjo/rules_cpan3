diff -urN a/BUILD.bazel b/BUILD.bazel
--- a/BUILD.bazel	1970-01-01 01:00:00.000000000 +0100
+++ b/BUILD.bazel	2026-11-24 00:23:24.539699006 +0100
@@ -0,0 +1,189 @@
+load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")
+
+package(default_visibility = ["//visibility:public"])
+
+GEN_HEADERS = [
+    "include/com_err.h",
+    "include/gssapi.h",
+    "include/gssapi/gssapi_alloc.h",
+    "include/gssapi/gssapi_ext.h",
+    "include/gssapi/gssapi_generic.h",
+    "include/gssapi/gssapi.h",
+    "include/gssapi/gssapi_krb5.h",
+    "include/gssapi/mechglue.h",
+    "include/gssrpc/auth_gssapi.h",
+    "include/gssrpc/auth_gss.h",
+    "include/gssrpc/auth.h",
+    "include/gssrpc/auth_unix.h",
+    "include/gssrpc/clnt.h",
+    "include/gssrpc/netdb.h",
+    "include/gssrpc/pmap_clnt.h",
+    "include/gssrpc/pmap_prot.h",
+    "include/gssrpc/pmap_rmt.h",
+    "include/gssrpc/rename.h",
+    "include/gssrpc/rpc.h",
+    "include/gssrpc/rpc_msg.h",
+    "include/gssrpc/svc_auth.h",
+    "include/gssrpc/svc.h",
+    "include/gssrpc/types.h",
+    "include/gssrpc/xdr.h",
+    "include/kadm5/admin.h",
+    "include/kadm5/chpass_util_strings.h",
+    "include/kadm5/kadm_err.h",
+    "include/kdb.h",
+    "include/krad.h",
+    "include/krb5.h",
+    "include/krb5/ccselect_plugin.h",
+    "include/krb5/certauth_plugin.h",
+    "include/krb5/clpreauth_plugin.h",
+    "include/krb5/hostrealm_plugin.h",
+    "include/krb5/kadm5_auth_plugin.h",
+    "include/krb5/kadm5_hook_plugin.h",
+    "include/krb5/kdcpolicy_plugin.h",
+    "include/krb5/kdcpreauth_plugin.h",
+    "include/krb5/krb5.h",
+    "include/krb5/localauth_plugin.h",
+    "include/krb5/locate_plugin.h",
+    "include/krb5/plugin.h",
+    "include/krb5/preauth_plugin.h",
+    "include/krb5/pwqual_plugin.h",
+    "include/profile.h",
+    "include/verto.h",
+    "include/verto-module.h",
+]
+
+GEN_LIBS = [
+    "lib/libcom_err.so",
+    "lib/libgssapi_krb5.so",
+    "lib/libgssrpc.so",
+    "lib/libk5crypto.so",
+    "lib/libkadm5clnt.so",
+    "lib/libkdb5.so",
+    "lib/libkrad.so",
+    "lib/libkrb5.so",
+    "lib/libkrb5support.so",
+    "lib/libverto.so",
+]
+
+genrule(
+    name = "krb5_libs",
+    srcs = glob(
+        ["**"],
+        exclude = [
+            "MODULE.bazel",
+            "BUILD.bazel",
+            "bazel-*/**",
+        ],
+    ),
+    outs = GEN_HEADERS + GEN_LIBS,
+    cmd = """
+        set -e
+        ROOT_DIR=$$(pwd)
+        SRC_ROOT=$$(pwd)/$$(dirname $$(dirname $(location src/configure)))
+        TMPDIR=$$(mktemp -d)
+        cp -rL $$SRC_ROOT/. $$TMPDIR/
+        cd $$TMPDIR/src
+        ./configure --disable-nls --without-ldap --without-tcl --disable-rpath --prefix=$$TMPDIR/inst CFLAGS="-std=gnu99 -g -O2" >/dev/null 2>&1
+        make -j4 WARN_CFLAGS="" >/dev/null 2>&1 || true
+        mkdir -p $$TMPDIR/inst/include $$TMPDIR/inst/lib
+        make install-mkdirs >/dev/null 2>&1
+        make -C util install >/dev/null 2>&1 || true
+        make -C include install >/dev/null 2>&1 || true
+        make -C lib install >/dev/null 2>&1 || true
+        make -C lib/kadm5 install >/dev/null 2>&1 || true
+        make -C lib/kadm5/clnt install >/dev/null 2>&1 || true
+        mkdir -p $$TMPDIR/inst/include/kadm5
+        cp -f $$TMPDIR/src/include/kadm5/*.h $$TMPDIR/inst/include/kadm5/ 2>/dev/null || true
+        cp -f $$TMPDIR/src/lib/kadm5/*.h $$TMPDIR/inst/include/kadm5/ 2>/dev/null || true
+        cd $$ROOT_DIR
+        mkdir -p $(RULEDIR)/include/gssapi $(RULEDIR)/include/gssrpc $(RULEDIR)/include/kadm5 $(RULEDIR)/include/krb5 $(RULEDIR)/lib
+        for f in $(OUTS); do
+            rel=$${f#$(RULEDIR)/}
+            cp -L $$TMPDIR/inst/$$rel $$f
+        done
+        rm -rf $$TMPDIR
+    """,
+)
+
+cc_import(
+    name = "com_err_lib",
+    shared_library = ":lib/libcom_err.so",
+)
+
+cc_import(
+    name = "k5crypto_lib",
+    shared_library = ":lib/libk5crypto.so",
+)
+
+cc_import(
+    name = "krb5support_lib",
+    shared_library = ":lib/libkrb5support.so",
+)
+
+cc_import(
+    name = "gssrpc_lib",
+    shared_library = ":lib/libgssrpc.so",
+)
+
+cc_import(
+    name = "gssapi_krb5_lib",
+    shared_library = ":lib/libgssapi_krb5.so",
+)
+
+cc_import(
+    name = "krb5_lib",
+    shared_library = ":lib/libkrb5.so",
+)
+
+cc_import(
+    name = "kadm5clnt_lib",
+    shared_library = ":lib/libkadm5clnt.so",
+)
+
+cc_library(
+    name = "headers",
+    hdrs = GEN_HEADERS,
+    includes = ["include"],
+)
+
+cc_library(
+    name = "com_err",
+    deps = [
+        ":com_err_lib",
+        ":headers",
+    ],
+)
+
+cc_library(
+    name = "k5crypto",
+    deps = [
+        ":headers",
+        ":k5crypto_lib",
+        ":krb5support_lib",
+    ],
+)
+
+cc_library(
+    name = "krb5",
+    deps = [
+        ":com_err",
+        ":headers",
+        ":k5crypto",
+        ":krb5_lib",
+        ":krb5support_lib",
+    ],
+)
+
+cc_library(
+    name = "kadm5clnt",
+    deps = [
+        ":com_err",
+        ":gssapi_krb5_lib",
+        ":gssrpc_lib",
+        ":headers",
+        ":k5crypto",
+        ":kadm5clnt_lib",
+        ":krb5",
+        ":krb5support_lib",
+    ],
+)
diff -urN a/src/config/shlib.conf b/src/config/shlib.conf
--- a/src/config/shlib.conf	2024-06-26 22:00:35.000000000 +0200
+++ b/src/config/shlib.conf	2026-11-24 00:23:24.539809736 +0100
@@ -57,7 +57,7 @@
 case $krb5_cv_host in
 alpha*-dec-osf*)
 	SHLIBVEXT='.so.$(LIBMAJOR).$(LIBMINOR)'
-	SHLIBSEXT='.so.$(LIBMAJOR)'
+	SHLIBSEXT='.so'
 	SHLIBEXT=.so
 	# Alpha OSF/1 doesn't need separate PIC objects
 	SHOBJEXT=.o
@@ -164,7 +164,7 @@
 
 mips-sgi-irix6.3)	# This is a Kludge; see below
 	SHLIBVEXT='.so.$(LIBMAJOR).$(LIBMINOR)'
-	SHLIBSEXT='.so.$(LIBMAJOR)'
+	SHLIBSEXT='.so'
 	SHLIBEXT=.so
 	SHOBJEXT=.o
 	# Kludge follows: (gcc makes n32 object files but ld expects o32, so we reeducate ld)
@@ -203,7 +203,7 @@
 
 mips-sgi-irix*)
 	SHLIBVEXT='.so.$(LIBMAJOR).$(LIBMINOR)'
-	SHLIBSEXT='.so.$(LIBMAJOR)'
+	SHLIBSEXT='.so'
 	SHLIBEXT=.so
 	SHOBJEXT=.o
 	if test "$ac_cv_c_compiler_gnu" = yes; then
@@ -263,7 +263,7 @@
 	SHLIB_EXPFLAGS='$(SHLIB_RPATH_FLAGS) $(SHLIB_DIRS) $(SHLIB_EXPLIBS)'
 	SHLIBEXT=.so
 	SHLIBVEXT='.so.$(LIBMAJOR).$(LIBMINOR)'
-	SHLIBSEXT='.so.$(LIBMAJOR)'
+	SHLIBSEXT='.so'
 	RPATH_FLAG=-R
 	PROG_RPATH_FLAGS='$(RPATH_FLAG)$(PROG_RPATH)'
 	CC_LINK_SHARED='$(CC) $(PROG_LIBPATH) $(PROG_RPATH_FLAGS) $(CFLAGS) $(LDFLAGS)'
@@ -278,7 +278,7 @@
 mips-*-netbsd*)
 	PICFLAGS=-fPIC
 	SHLIBVEXT='.so.$(LIBMAJOR).$(LIBMINOR)'
-	SHLIBSEXT='.so.$(LIBMAJOR)'
+	SHLIBSEXT='.so'
 	SHLIBEXT=.so
 	LDCOMBINE='ld -shared -soname $(LIBPREFIX)$(LIBBASE)$(SHLIBSEXT)'
 	SHLIB_RPATH_FLAGS='-R$(SHLIB_RDIRS)'
@@ -401,7 +401,7 @@
 		esac
 	fi
 	SHLIBVEXT='.so.$(LIBMAJOR).$(LIBMINOR)'
-	SHLIBSEXT='.so.$(LIBMAJOR)'
+	SHLIBSEXT='.so'
 	SHLIBEXT=.so
 	SHLIB_RPATH_FLAGS='-R$(SHLIB_RDIRS)'
 	SHLIB_EXPFLAGS='$(SHLIB_RPATH_FLAGS) $(SHLIB_DIRS) $(SHLIB_EXPLIBS)'
@@ -419,7 +419,7 @@
 *-*-linux* | *-*-gnu* | *-*-k*bsd*-gnu)
 	PICFLAGS=-fPIC
 	SHLIBVEXT='.so.$(LIBMAJOR).$(LIBMINOR)'
-	SHLIBSEXT='.so.$(LIBMAJOR)'
+	SHLIBSEXT='.so'
 	SHLIBEXT=.so
 	# Linux ld doesn't default to stuffing the SONAME field...
 	# Use objdump -x to examine the fields of the library
