{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "rules_cpan lockfile schema",
  "description": "Schema for cpan.lock.json lockfiles generated by rules_cpan resolver",
  "type": "object",
  "required": [
    "lock_version",
    "root_dependencies",
    "distributions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "lock_version": {
      "type": "string",
      "description": "Lockfile format version"
    },
    "comment": {
      "type": "string",
      "description": "Informational comment"
    },
    "root_dependencies": {
      "type": "array",
      "description": "Explicit top-level user requirements from deps.txt",
      "items": {
        "type": "string"
      }
    },
    "distributions": {
      "type": "object",
      "description": "Transitive dependency closure of CPAN distributions",
      "additionalProperties": {
        "type": "object",
        "required": [
          "version",
          "url",
          "sha256",
          "is_xs",
          "provides",
          "dependencies"
        ],
        "properties": {
          "version": {
            "type": "string",
            "description": "Exact distribution release version"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Upstream archive download URL"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$",
            "description": "SHA256 checksum of the upstream archive"
          },
          "is_xs": {
            "type": "boolean",
            "description": "True if distribution contains XS/C/C++ extensions, False for pure Perl"
          },
          "provides": {
            "type": "array",
            "description": "Perl modules and packages provided by this distribution",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "object",
            "description": "Transitive dependencies on other CPAN distributions by phase",
            "properties": {
              "build": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "configure": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "runtime": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "test": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
