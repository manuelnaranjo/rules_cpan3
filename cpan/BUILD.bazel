load("@bazel_lib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

exports_files(["cpan.lock.schema.json"])

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = [
        "//cpan/private:rules",
        "//platforms:platforms_bzl",
    ],
)

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    deps = [
        "//cpan/private:rules",
    ],
)
