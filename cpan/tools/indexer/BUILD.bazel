load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "indexer_lib",
    srcs = [
        "heuristics.py",
        "indexer.py",
    ],
    data = [
        "//cpan/resources/dbi:DBIXS.h",
        "//cpan/resources/dbi:Driver.xst",
        "//cpan/resources/dbi:Driver_xst.h",
        "//cpan/resources/dbi:dbd_xsh.h",
        "//cpan/resources/dbi:dbi_sql.h",
        "//cpan/resources/dbi:dbipport.h",
        "//cpan/resources/dbi:dbivport.h",
        "//cpan/resources/dbi:dbixs_rev.h",
        "//cpan/resources/ppport:ppport.h",
    ],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "indexer",
    srcs = ["indexer.py"],
    main = "indexer.py",
    visibility = ["//visibility:public"],
    deps = [":indexer_lib"],
)

alias(
    name = "cpan_indexer",
    actual = ":indexer",
    visibility = ["//visibility:public"],
)
