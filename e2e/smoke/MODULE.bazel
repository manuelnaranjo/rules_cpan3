bazel_dep(name = "rules_cpan", version = "0.0.0", dev_dependency = True)
bazel_dep(name = "bazel_skylib", version = "1.9.2", dev_dependency = True)

bazel_dep(name = "rules_perl", version = "2.1.0")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "ape", version = "1.1.0")
bazel_dep(name = "protobuf", version = "33.6")
bazel_dep(name = "llvm", version = "0.8.27")

register_toolchains("@llvm//toolchain:all")

local_path_override(
    module_name = "rules_cpan",
    path = "../..",
)

# CPAN dependency installation via Bzlmod module extension
cpan = use_extension("@rules_cpan//cpan:extensions.bzl", "cpan")
cpan.install(
    name = "cpan",
    lock = "//:cpan.lock.json",
)
use_repo(cpan, "cpan")
