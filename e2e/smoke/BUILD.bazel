"""Provides a simple way to test your rules as an external module."""

load("@bazel_skylib//rules:build_test.bzl", "build_test")

build_test(
    name = "smoke_test",
    targets = [
        "@rules_cpan//platforms:darwin_arm64",
        "@rules_cpan//platforms:darwin_x86_64",
        "@rules_cpan//platforms:linux_arm64",
        "@rules_cpan//platforms:linux_x86_64",
        "@rules_cpan//platforms:rbe_linux_arm64",
        "@rules_cpan//platforms:rbe_linux_x86_64",
    ],
)
