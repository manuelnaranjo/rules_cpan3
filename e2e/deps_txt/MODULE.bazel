cpan.annotation(
    distribution = "Compress-Zstd",
    hub = "cpan",
    native_deps = ["@zstd//:zstd"],
    patch_cmds = [
        "sed -i -e '/compress\\/zstdmt_compress\\.h/d' -e 's/ZSTDMT_CCtx\\* cctx;/ZSTD_CCtx* cctx;/' -e 's/cctx = ZSTDMT_createCCtx(nbThreads);/cctx = ZSTD_createCCtx(); ZSTD_CCtx_setParameter(cctx, ZSTD_c_nbWorkers, (int)nbThreads); ZSTD_CCtx_setParameter(cctx, ZSTD_c_compressionLevel, level);/' -e 's/ret = ZSTDMT_compressCCtx(cctx, dst, bound + 1, src, src_len, level);/ret = ZSTD_compress2(cctx, dst, bound + 1, src, src_len);/' -e 's/ZSTDMT_freeCCtx(cctx);/ZSTD_freeCCtx(cctx);/' lib/Compress/Zstd.xs",
        "sed -i -e 's/10403/ZSTD_VERSION_NUMBER()/' -e \"s/'1.4.3'/ZSTD_VERSION_STRING()/\" t/01_basic.t",
    ],
    patch_cmds_win = [
        "powershell -Command \"(Get-Content lib\\Compress\\Zstd.xs) -replace '#include .compress/zstdmt_compress.h.', '' -replace 'ZSTDMT_CCtx\\* cctx;', 'ZSTD_CCtx* cctx;' -replace 'cctx = ZSTDMT_createCCtx\\(nbThreads\\);', 'cctx = ZSTD_createCCtx(); ZSTD_CCtx_setParameter(cctx, ZSTD_c_nbWorkers, (int)nbThreads); ZSTD_CCtx_setParameter(cctx, ZSTD_c_compressionLevel, level);' -replace 'ret = ZSTDMT_compressCCtx\\(cctx, dst, bound \\+ 1, src, src_len, level\\);', 'ret = ZSTD_compress2(cctx, dst, bound + 1, src, src_len);' -replace 'ZSTDMT_freeCCtx\\(cctx\\);', 'ZSTD_freeCCtx(cctx);' | Set-Content lib\\Compress\\Zstd.xs\"",
        "powershell -Command \"(Get-Content t\\01_basic.t) -replace '10403', 'ZSTD_VERSION_NUMBER()' -replace '''1.4.3''', 'ZSTD_VERSION_STRING()' | Set-Content t\\01_basic.t\"",
    ],
)
