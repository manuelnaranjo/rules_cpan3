load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_perl//perl:defs.bzl", "perl_test")

package(default_visibility = ["//visibility:public"])

build_test(
    name = "smoke_test",
    targets = [
        "@rules_cpan//platforms:linux_x86_64",
    ],
)

test_suite(
    name = "pakket_tests",
    tags = ["manual"],
    tests = [
        ":e2e_pakket_integration_test",
        "@cpan//:test-rules-cpan-modules",
        "@pakket//:package_utils_test",
        "@pakket//:utils_test",
        "@pakket//:versioner_test",
    ],
)

perl_test(
    name = "e2e_pakket_integration_test",
    size = "small",
    srcs = ["test_pakket_e2e.t"],
    tags = ["manual"],
    deps = [
        "@cpan//Compress-Raw-Zlib",
        "@cpan//Test-Simple",
        "@pakket",
    ],
)
