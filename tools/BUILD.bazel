load("@bazel_gazelle//:def.bzl", "gazelle", "gazelle_binary")
load("@bazelrc-preset.bzl", "bazelrc_preset")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

bazelrc_preset(
    name = "preset",
    doc_link_template = "https://registry.build/flag/bazel?filter={flag}",
)

# gazelle:map_kind bzl_library bzl_library @bazel_lib//:bzl_library.bzl
gazelle_binary(
    name = "gazelle_bin",
    languages = ["@bazel_skylib_gazelle_plugin//bzl"],
)

gazelle(
    name = "gazelle",
    gazelle = "gazelle_bin",
    visibility = ["//visibility:public"],
)

exports_files([
    "port_3rdparty.py",
    "port_3rdparty.sh",
    "setup_rbe.sh",
])

sh_binary(
    name = "port_3rdparty",
    srcs = ["port_3rdparty.sh"],
    data = ["port_3rdparty.py"],
    visibility = ["//visibility:public"],
)
