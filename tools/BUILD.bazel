load("@aspect_gazelle_prebuilt//:def.bzl", "aspect_gazelle")
load("@bazelrc-preset.bzl", "bazelrc_preset")

bazelrc_preset(
    name = "preset",
    doc_link_template = "https://registry.build/flag/bazel?filter={flag}",
)

# gazelle:map_kind bzl_library bzl_library @bazel_lib//:bzl_library.bzl
# gazelle:map_kind py_binary py_binary @aspect_rules_py//py:defs.bzl
# gazelle:map_kind py_library py_library @aspect_rules_py//py:defs.bzl
# gazelle:map_kind py_test py_test @aspect_rules_py//py:defs.bzl

aspect_gazelle(
    name = "gazelle",
    languages = [
        "starlark",
        "python",
    ],
    visibility = ["//visibility:public"],
    with_check = True,
)

alias(
    name = "resolver",
    actual = "//cpan/tools/resolver:resolver",
    visibility = ["//visibility:public"],
)

alias(
    name = "cpan_resolver",
    actual = "//cpan/tools/resolver:resolver",
    visibility = ["//visibility:public"],
)

exports_files(["setup_rbe.sh"])
