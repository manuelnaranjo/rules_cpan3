########################
# Import bazelrc presets
import %workspace%/tools/preset.bazelrc

# Don’t want to push a rules author to update their deps if not needed.
# https://bazel.build/reference/command-line-reference#flag--check_direct_dependencies
# https://bazelbuild.slack.com/archives/C014RARENH0/p1691158021917459?thread_ts=1691156601.420349&cid=C014RARENH0
common --config=ruleset

# Bazel settings that apply to this repository.
# Take care to document any settings that you expect users to apply.

# Use prebuilt protoc rather than compiling from C++ source
common --@protobuf//bazel/toolchains:prefer_prebuilt_protoc
common --incompatible_enable_proto_toolchain_resolution

# Perl rules configuration (enable XS dynamic loading)
common --@rules_perl//perl/settings:xs=true

# --- BuildBuddy Remote Build Execution (RBE) Configuration ---
# Remote executor, cache, and BES endpoints
common:rbe --remote_executor=grpcs://remote.buildbuddy.io
common:rbe --remote_cache=grpcs://remote.buildbuddy.io
common:rbe --bes_backend=grpcs://remote.buildbuddy.io
common:rbe --bes_results_url=https://app.buildbuddy.io/invocation/

# Remote execution properties compatible with hermetic toolchains (LLVM + Perl)
common:rbe --remote_default_exec_properties=container-image=docker://gcr.io/flame-public/rbe-ubuntu22-04:latest
common:rbe --remote_default_exec_properties=OSFamily=Linux
common:rbe --extra_execution_platforms=//platforms:rbe_linux_x86_64

# Execution and caching optimizations
common:rbe --remote_download_outputs=minimal
common:rbe --remote_download_regex='.*\.log$'
common:rbe --remote_timeout=3600
common:rbe --remote_upload_local_results=true
common:rbe --jobs=50

# Ensure that the MODULE.bazel.lock file is complete and committed.
common --lockfile_mode=update

# Load any settings specific to the current user.
try-import %workspace%/.bazelrc.user
