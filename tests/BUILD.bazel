load("@aspect_rules_py//py:defs.bzl", "py_test")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")
load("@rules_perl//perl:perl.bzl", "perl_binary", "perl_test")
load("//platforms:transitions.bzl", "multi_platform_test", "platform_binary")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.Compress-Raw-Zlib.bazel",
    "cpan.lock.json",
    "deps.txt",
])

# 1. Hermetic C test verifying LLVM compiler
cc_test(
    name = "cc_toolchain_test",
    size = "small",
    srcs = ["test_cc.c"],
)

# 2. Hermetic Perl test verifying rules_perl toolchain
perl_test(
    name = "perl_toolchain_test",
    size = "small",
    srcs = ["test_perl.t"],
)

# 3. Base binaries for cross-platform transitions
cc_binary(
    name = "cross_cc_binary",
    srcs = ["test_cc.c"],
)

perl_binary(
    name = "cross_perl_binary",
    srcs = ["test_perl.t"],
    main = "test_perl.t",
)

# 4. Multi-arch platform binaries across Linux & macOS (x86_64 & arm64)
platform_binary(
    name = "cross_cc_linux_x86_64",
    actual = ":cross_cc_binary",
    platform = "//platforms:linux_x86_64",
)

platform_binary(
    name = "cross_cc_linux_arm64",
    actual = ":cross_cc_binary",
    platform = "//platforms:linux_arm64",
)

platform_binary(
    name = "cross_cc_rbe_linux_x86_64",
    actual = ":cross_cc_binary",
    platform = "//platforms:rbe_linux_x86_64",
)

platform_binary(
    name = "cross_perl_linux_x86_64",
    actual = ":cross_perl_binary",
    platform = "//platforms:linux_x86_64",
)

platform_binary(
    name = "cross_perl_linux_arm64",
    actual = ":cross_perl_binary",
    platform = "//platforms:linux_arm64",
)

platform_binary(
    name = "cross_perl_darwin_x86_64",
    actual = ":cross_perl_binary",
    platform = "//platforms:darwin_x86_64",
)

platform_binary(
    name = "cross_perl_darwin_arm64",
    actual = ":cross_perl_binary",
    platform = "//platforms:darwin_arm64",
)

# Multi-platform verification test ensuring cross targets are buildable across platforms
multi_platform_test(
    name = "cross_compilation_test",
    size = "small",
    targets = [
        ":cross_cc_linux_x86_64",
        ":cross_cc_linux_arm64",
        ":cross_cc_rbe_linux_x86_64",
        ":cross_perl_linux_x86_64",
        ":cross_perl_linux_arm64",
        ":cross_perl_darwin_x86_64",
        ":cross_perl_darwin_arm64",
    ],
)

# CPAN module tests building and linking against BCR native C dependencies (@zlib)
test_suite(
    name = "cpan_compress_raw_zlib_tests",
    tests = [
        "@cpan_compress_raw_zlib//:version_test",
        "@cpan_compress_raw_zlib//:zlib_test",
    ],
)

# 5. Resolver and lockfile generator unit and integration test
py_test(
    name = "resolver_test",
    size = "small",
    srcs = ["resolver_test.py"],
    data = [
        "cpan.lock.json",
        "deps.txt",
        "//cpan:cpan.lock.schema.json",
    ],
    deps = ["//cpan/tools/resolver:resolver_lib"],
)

# 6. Indexer tool unit and integration test
py_test(
    name = "indexer_test",
    size = "small",
    srcs = ["indexer_test.py"],
    deps = ["//cpan/tools/indexer:indexer_lib"],
)

# 6. Bzlmod module extension & repository rules tests
perl_test(
    name = "cpan_pureperl_test",
    size = "small",
    srcs = ["test_cpan_pureperl.t"],
    deps = [
        "@cpan//Algorithm-Diff",
    ],
)

perl_test(
    name = "cpan_xs_test",
    size = "small",
    srcs = ["test_cpan_xs.t"],
    deps = [
        "@cpan//Compress-Raw-Zlib",
    ],
)

perl_test(
    name = "cpan_alt_test",
    size = "small",
    srcs = ["test_cpan_alt.t"],
    deps = [
        "@cpan_alt//Algorithm-Diff",
    ],
)

py_test(
    name = "bzlmod_extension_test",
    size = "small",
    srcs = ["bzlmod_extension_test.py"],
    data = [
        "cpan.lock.json",
    ],
)

test_suite(
    name = "cpan_hub_all_tests",
    tags = ["-manual"],
    tests = [
        "@cpan//:all_tests",
    ],
)
