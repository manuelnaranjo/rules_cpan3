"""rules_cpan: Bazel rules for consuming Perl CPAN dependencies hermetically"""

module(
    name = "rules_cpan",
)

# Registries configured in .bazelrc:
# 1. file://%workspace%/registry (Local BCR registry for 3rdparty native C/C++ dependencies)
# 2. https://bcr.bazel.build (Public Bazel Central Registry)
# registry = ["file://%workspace%/registry", "https://bcr.bazel.build"]

# Native C/C++ dependencies (consumed from BCR or local registry)
bazel_dep(name = "zlib", version = "1.3.1.bcr.5")
bazel_dep(name = "bzip2", version = "1.0.8.bcr.4")
bazel_dep(name = "libexpat", version = "2.7.1.bcr.1")
bazel_dep(name = "zstd", version = "1.5.7.bcr.1")
bazel_dep(name = "openssl", version = "3.3.1.bcr.13")
bazel_dep(name = "libxml2", version = "2.15.4")
bazel_dep(name = "lz4", version = "1.10.0.bcr.2")
bazel_dep(name = "snappy", version = "1.2.2.bcr.3")
bazel_dep(name = "ncurses", version = "6.4.20221231.bcr.15")
bazel_dep(name = "linux-pam", version = "1.7.3")
bazel_dep(name = "libsodium", version = "1.0.19")
bazel_dep(name = "gmp", version = "6.3.0.bcr.5")
bazel_dep(name = "cmark", version = "0.31.1.cpan-external.1")
bazel_dep(name = "libsass", version = "3.6.6.cpan-external.1")
bazel_dep(name = "discount", version = "3.0.2.0.cpan-external.1")
bazel_dep(name = "libiconv", version = "1.18.cpan-external.1")
bazel_dep(name = "krb5", version = "1.22.3.cpan-external.1")
bazel_dep(name = "grpc", version = "1.85.4")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "package_metadata", version = "0.0.15")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_perl", version = "2.1.0")
bazel_dep(name = "aspect_rules_py", version = "1.13.0")
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")

bazel_dep(name = "aspect_gazelle_prebuilt", version = "0.0.29", dev_dependency = True)

bazel_dep(name = "llvm", version = "0.8.27")

register_toolchains("@llvm//toolchain:all")

bazel_dep(name = "bazel_lib", version = "3.8.0")

bazel_dep(name = "stardoc", version = "0.8.1", dev_dependency = True)
bazel_dep(name = "protobuf", version = "33.6", dev_dependency = True)

interpreters = use_extension("@aspect_rules_py//py/unstable:extension.bzl", "python_interpreters")
interpreters.toolchain(
    is_default = True,
    python_version = "3.11",
)
use_repo(interpreters, "python_interpreters")

register_toolchains("@python_interpreters//:all")

uv = use_extension("@aspect_rules_py//uv/unstable:extension.bzl", "uv")
uv.declare_hub(hub_name = "uv")
uv.project(
    name = "rules-cpan-tools",
    default_build_dependencies = [],
    hub_name = "uv",
    lock = "//:uv.lock",
    pyproject = "//:pyproject.toml",
)
use_repo(uv, "uv")

bazel_dep(name = "bazelrc-preset.bzl", version = "1.10.0")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "ape", version = "1.1.0")

# CPAN dependency installation via Bzlmod module extension
cpan = use_extension("//cpan:extensions.bzl", "cpan")
cpan.install(
    name = "cpan",
    lock = "//tests:cpan.lock.json",
)
cpan.install(
    name = "cpan_alt",
    lock = "//tests:cpan.lock.json",
)

single_version_override(
    module_name = "audit-userspace",
    patch_strip = 1,
    patches = ["//bazel/patches:audit-userspace-fix-kernel-headers.patch"],
)

single_version_override(
    module_name = "libsodium",
    patch_strip = 1,
    patches = ["//bazel/patches:libsodium-full-build.patch"],
)

single_version_override(
    module_name = "linux-pam",
    patch_strip = 1,
    patches = ["//bazel/patches:linux-pam-disable-close-range.patch"],
)

use_repo(cpan, "cpan", "cpan_alt")

# External CPAN test dependency for hermetic XS C integration testing
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "cpan_compress_raw_zlib",
    build_file = "//tests:BUILD.Compress-Raw-Zlib.bazel",
    dev_dependency = True,
    integrity = "sha256-gNwQSnM5duukDb6Scs0y6/GDGVIE4L3TDiFKN9KsQss=",
    patch_cmds = [
        "cp fallback/constants.h constants.h",
        "cp fallback/constants.xs constants.xs",
    ],
    patch_cmds_win = [
        "copy fallback\\constants.h constants.h",
        "copy fallback\\constants.xs constants.xs",
    ],
    strip_prefix = "Compress-Raw-Zlib-2.226",
    urls = ["https://cpan.metacpan.org/authors/id/P/PM/PMQS/Compress-Raw-Zlib-2.226.tar.gz"],
)
