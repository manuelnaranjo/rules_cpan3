load("@stardoc//stardoc:stardoc.bzl", "stardoc")

_CPAN_PUBLIC_FILES = [
    "defs",
    "extensions",
]

[
    stardoc(
        name = name,
        out = "{}.md".format(name),
        input = "//cpan:{}.bzl".format(name),
        deps = ["//cpan:{}".format(name)],
    )
    for name in _CPAN_PUBLIC_FILES
]

stardoc(
    name = "platforms",
    out = "platforms.md",
    input = "//platforms:platforms.bzl",
    deps = ["//platforms:platforms_bzl"],
)

stardoc(
    name = "transitions",
    out = "transitions.md",
    input = "//platforms:transitions.bzl",
    deps = ["//platforms:platforms_bzl"],
)

filegroup(
    name = "docs",
    srcs = [":{}".format(name) for name in _CPAN_PUBLIC_FILES] + [
        ":platforms",
        ":transitions",
    ],
)
