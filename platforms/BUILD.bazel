load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

bzl_library(
    name = "platforms_bzl",
    srcs = [
        "platforms.bzl",
        "transitions.bzl",
    ],
    deps = [
        "@bazel_skylib//lib:paths",
    ],
)

# Linux x86_64
platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

# Linux ARM64 (aarch64)
platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

alias(
    name = "linux_aarch64",
    actual = ":linux_arm64",
)

# macOS / Darwin x86_64
platform(
    name = "darwin_x86_64",
    constraint_values = [
        "@platforms//os:osx",
        "@platforms//cpu:x86_64",
    ],
)

alias(
    name = "macos_x86_64",
    actual = ":darwin_x86_64",
)

alias(
    name = "osx_x86_64",
    actual = ":darwin_x86_64",
)

# macOS / Darwin ARM64
platform(
    name = "darwin_arm64",
    constraint_values = [
        "@platforms//os:osx",
        "@platforms//cpu:arm64",
    ],
)

alias(
    name = "darwin_aarch64",
    actual = ":darwin_arm64",
)

alias(
    name = "macos_arm64",
    actual = ":darwin_arm64",
)

alias(
    name = "osx_arm64",
    actual = ":darwin_arm64",
)

# BuildBuddy RBE execution platform for Linux x86_64
platform(
    name = "rbe_linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    exec_properties = {
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu22-04:latest",
        "OSFamily": "Linux",
    },
)

# BuildBuddy RBE execution platform for Linux ARM64
platform(
    name = "rbe_linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    exec_properties = {
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu22-04:latest",
        "OSFamily": "Linux",
    },
)
