[
    (
        awk(
            name = name + "_h",
            src = src,
            out = out_h,
            assign = {
                "outfile": "/dev/stdout",
            },
            progfile = "src/util/et/et_h.awk",
        ),
        awk(
            name = name + "_c",
            src = src,
            out = out_c,
            assign = {
                "outfile": "/dev/stdout",
            },
            progfile = "src/util/et/et_c.awk",
        ),
    )
    for name, src, out_h, out_c in ERROR_TABLES
]

