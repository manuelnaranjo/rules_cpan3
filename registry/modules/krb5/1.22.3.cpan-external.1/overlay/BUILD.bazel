    deps = [":gen_lib"],
)

run_binary(
    name = "errmap_h",
    outs = ["src/lib/gssapi/generic/errmap.h"],
    args = [
        "bimap",
        "$(execpath src/lib/gssapi/generic/errmap.h)",
        "NAME=mecherrmap",
        "LEFT=OM_uint32",
        "'RIGHT=struct mecherror'",
        "LEFTPRINT=print_OM_uint32",
        "RIGHTPRINT=mecherror_print",
        "LEFTCMP=cmp_OM_uint32",
        "RIGHTCMP=mecherror_cmp",
    ],
    tool = ":gen",
)

genrule(
    name = "krb5_h",
    srcs = [
        "src/include/krb5/krb5.hin",
        ":asn1_err_h",
        ":k5e1_err_h",
        ":kdb5_err_h",
        ":krb524_err_h",
        ":krb5_err_h",
        ":kv5m_err_h",
    ],
    outs = ["src/include/krb5/krb5.h"],
    cmd = """
echo "/* This file is generated, please don't edit it directly. */" > $@
echo "#ifndef KRB5_KRB5_H_INCLUDED" >> $@
echo "#define KRB5_KRB5_H_INCLUDED" >> $@
cat $(execpath src/include/krb5/krb5.hin) \
    $(execpath :krb5_err_h) \
    $(execpath :k5e1_err_h) \
    $(execpath :kdb5_err_h) \
    $(execpath :kv5m_err_h) \
    $(execpath :krb524_err_h) \
    $(execpath :asn1_err_h) >> $@
echo "#endif /* KRB5_KRB5_H_INCLUDED */" >> $@
""",
)

genrule(
    name = "profile_h",
    srcs = [
        "src/util/profile/profile.hin",
        ":prof_err_h",
    ],
    outs = ["src/include/profile.h"],
    cmd = "cat $(execpath src/util/profile/profile.hin) $(execpath :prof_err_h) > $@",
)

