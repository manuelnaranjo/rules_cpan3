run_binary(
    name = "error_map_h",
    outs = ["src/lib/gssapi/krb5/error_map.h"],
    args = [
        "-o$(execpath src/lib/gssapi/krb5/error_map.h)",
        "NAME=gsserrmap",
        "KEY=OM_uint32",
        "'VALUE=char *'",
        "COMPARE=compare_OM_uint32",
        "FREEVALUE=free_string",
    ],
    tool = ":gen_map",
)

